  "description": "A lightweight, open-source 3D house builder that runs entirely in the browser using Three.js.",
  "author": "Bassem Chagra",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ch-bas/threejs-sims-house-builder.git"
  },
  "homepage": "https://ch-bas.github.io/threejs-sims-house-builder/",
  "bugs": {
    "url": "https://github.com/ch-bas/threejs-sims-house-builder/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/add-csp.mjs",
    "start": "npx --yes serve@14 out",
    "lint": "eslint --ext .ts,.tsx app components lib",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "^15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
